INVENTORY_SUPABASE_URL=http://127.0.0.1:55321
INVENTORY_SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://127.0.0.1:5173
PORT=3006

# Direct scheduler connection to the same Supabase PostgreSQL database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DEALERSHIP_TIMEZONE=UTC
# Monday through Sunday; null means closed.
DEALERSHIP_OPENING_HOURS=[{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},null,null]
# Better Auth signs JWT access tokens; keep this server secret private.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3006
# Required CA path only when DATABASE_URL points at hosted PostgreSQL.
PGSSLROOTCERT=

# Sales Leads reuses the local inventory database by default.
# Set both overrides only when using a separate loopback Supabase project.
# LEADS_SUPABASE_URL=http://127.0.0.1:55321
# LEADS_SUPABASE_SERVICE_ROLE_KEY=

# Optional loopback mock-system base URLs. Defaults derive from PORT.
# DOCUMENT_SALES_API_URL=http://127.0.0.1:3006/mock/sales
# DOCUMENT_SERVICE_API_URL=http://127.0.0.1:3006/mock/service
