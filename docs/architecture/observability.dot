digraph Observability {
  graph [rankdir=LR, newrank=true, bgcolor="#ffffff", pad=0.35, nodesep=0.55, ranksep=0.7, fontname="Helvetica", fontsize=20, label="Target observability architecture | proposed", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.20,0.14"];
  edge [fontname="Helvetica", fontsize=10, color="#64748b", arrowsize=0.7];

  api [label="NestJS API\nstructured logs + /metrics", fillcolor="#eef2ff", color="#818cf8"];
  db [label="Supabase PostgreSQL\ndatabase statistics", fillcolor="#ecfdf5", color="#34d399"];
  alloy [label="Grafana Alloy\nlog collection", fillcolor="#fef3c7", color="#f59e0b"];
  exporter [label="PostgreSQL exporter\nmetrics endpoint", fillcolor="#fef3c7", color="#f59e0b"];
  loki [label="Loki\nlog storage", fillcolor="#f0fdfa", color="#2dd4bf"];
  prometheus [label="Prometheus\nscrape + metric storage", fillcolor="#f0fdfa", color="#2dd4bf"];
  grafana [label="Grafana\ndashboards + alerts", fillcolor="#fce7f3", color="#ec4899"];
  operators [label="Operators\ninvestigate + respond", fillcolor="#f8fafc", color="#94a3b8"];

  { rank=same; api; db; }
  { rank=same; alloy; exporter; }
  { rank=same; loki; prometheus; }

  api -> alloy [label="JSON stdout"];
  alloy -> loki [label="ship logs"];
  api -> prometheus [label="/metrics scraped"];
  db -> exporter [label="read stats"];
  exporter -> prometheus [label="metrics scraped"];
  loki -> grafana [label="LogQL results"];
  prometheus -> grafana [label="PromQL results"];
  grafana -> operators [label="visualize + alert"];
}
