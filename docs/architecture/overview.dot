digraph Overview {
  graph [rankdir=TB, newrank=true, bgcolor="#ffffff", pad=0.35, nodesep=0.65, ranksep=0.65, fontname="Helvetica", fontsize=20, label="Dealership platform | Four-scenario overview", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#818cf8", fontname="Helvetica", fontsize=12, margin="0.20,0.14"];
  edge [fontname="Helvetica", fontsize=10, color="#64748b", arrowsize=0.7];

  subgraph cluster_web {
    label="One React frontend / apps/web (one web server)"; fontsize=14; color="#cbd5e1"; style=rounded;
    staff [label="Staff routes /admin/*\nBookings | Inventory | Leads | Documents\nShared admin layout"];
    guest [label="Guest routes /appointments\nCalendar + booking form + availability\nShared UI package and providers"];
  }
  proxy [label="One Vite server / API proxies\nOne backend origin for all scenarios\n/api: public + staff REST\n/booking-api: staff booking REST", fillcolor="#f8fafc", color="#94a3b8"];
  subgraph cluster_main {
    label="One NestJS process / apps/api"; fontsize=14; color="#cbd5e1"; style=rounded;
    main [label="REST controllers + feature modules\nInventory | Leads | Documents | Bookings\nGuest public | staff JWT + current role/session"];
    auth [label="Better Auth + JWT/role guard\nEmail/password | HTTP-only renewal cookie\n5-minute JWT | Admin + Technician"];
    main -> auth [label="staff requests"];
    mocks [label="Mock Sales + Service APIs\nDifferent document payload formats", fillcolor="#fff7ed", color="#fb923c"];
    main -> mocks [label="parallel local HTTP"];
  }
  subgraph cluster_supabase {
    label="One shared Supabase project / keyloop-inventory-local"; labelloc=b; fontsize=14; color="#34d399"; style=rounded;
    data_api [label="Supabase Data API\nInventory + lead reads / writes / RPCs", fillcolor="#f8fafc", color="#94a3b8"];
    db [shape=cylinder, label="One Supabase PostgreSQL database\npublic: inventory + leads + bookings\nUnified users + roles + resources\nRLS + grants protect private tables", fillcolor="#ecfdf5", color="#34d399"];
    realtime [label="Supabase Realtime\nInventory: empty Broadcast\nAppointments: date-only Broadcast", fillcolor="#f0fdfa", color="#2dd4bf"];
    data_api -> db [label="SQL / database functions"];
    db -> realtime [style=dashed, label="sanitized committed-change triggers"];
  }
  { rank=same; staff; guest; }
  { rank=same; mocks; data_api; }

  staff -> proxy [label="Login + JWT REST / JSON"];
  proxy -> main [label="all scenario REST requests"];
  guest -> proxy [label="public REST / JSON"];
  main -> data_api [label="Data API reads / RPCs"];
  auth -> db [label="protected public: users / sessions / keys"];
  main -> db [label="BookingsModule: TypeORM / SQL transactions"];
  realtime -> staff [style=dashed, label="Inventory + booking notifications\n→ HTTP refetch", constraint=false, color="#0d9488"];
  realtime -> guest [style=dashed, label="Availability notifications\n→ HTTP refetch", constraint=false, color="#0d9488"];
}
